{
  "name": "monboreseau",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "graphql": "graphql-codegen --config codegen.yml",
    "start": "next dev",
    "build:static": "yarn run build:next",
    "build:pre": "tsx ./build/scripts/prebuild.ts",
    "build:next": "yarn run build:pre && next build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "tsc-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-leaflet/core": "^3.0.0",
    "framer-motion": "^14.0.0",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.22.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/lunr": "^2.3.7",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "danger": "^14.0.7",
    "eslint": "^10.12.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "server-only-context": "^0.1.0",
    "tsx": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "undici": "^7",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.15.0"
